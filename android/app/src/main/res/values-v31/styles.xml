<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ এর নিজস্ব splash screen: গাঢ় বেগুনি ব্যাকগ্রাউন্ডে অ্যাপ আইকন -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/gg_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/gg_background</item>
    </style>
</resources>
